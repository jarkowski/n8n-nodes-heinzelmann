{
  "name": "n8n-nodes-heinzelmann",
  "version": "0.1.7",
  "description": "n8n node for FCS Heinzelmann",
  "license": "MIT",
  "homepage": "https://github.com/jarkowski/n8n-nodes-heinzelmann",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "David Jarkowski",
    "email": "david@jarkowski.name"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarkowski/n8n-nodes-heinzelmann.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HeinzelmannApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Heinzelmann/Heinzelmann.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
